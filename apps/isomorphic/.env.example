# =============================================================================
# Rawura — oep-web-admin (apps/isomorphic)
# Next.js 15.2.6 / React 19 App Router admin dashboard.
# Runs on PORT 4999 (`next dev -p 4999`).
#
# USAGE:
#   cp .env.example .env    # then fill in the placeholders below
#   pnpm install && pnpm dev
#
# BOOT ORDER — this app is a pure frontend. It owns no database and no payment
# provider; it talks to other Rawura services over HTTP. Start these FIRST:
#   1. Main-server API    -> http://localhost:3000   (NEXT_PUBLIC_API_URL)
#                            Admin sign-in POSTs to it; without it login fails.
#   2. WebSocket service  -> http://localhost:3003   (NEXT_PUBLIC_WEBSOCKET_URL)
#                            Optional — live product updates only.
#   3. Storefront         -> http://localhost:3009   (NEXT_PUBLIC_STOREFRONT_URL)
#                            Optional — only for outbound links to the shop.
#
# VALIDATION: src/env.mjs (@t3-oss/env-nextjs + zod) runs at build/boot via
# next.config.mjs. Anything it marks non-optional aborts the build if unset.
# Every var it declares appears in this file.
#
# NEXT_PUBLIC_* vars are INLINED INTO THE CLIENT BUNDLE at build time.
# Never put a secret behind that prefix, and rebuild after changing one.
#
# PLACEHOLDERS: every value written as CHANGE_ME_* must be replaced. The zod
# schema only checks that secrets are non-empty, so a copied CHANGE_ME_* value
# PASSES validation and the app boots with a broken key instead of failing
# loudly. Search this file for CHANGE_ME_ before your first run.
# =============================================================================


# ---- Core ----

# Runtime mode. Validated by src/env.mjs as one of: development | test | production.
# REQUIRED by the schema, but Next.js sets it automatically (`next dev` =>
# development, `next build` => production), so you normally do NOT set it here.
# Only set it explicitly for a `test` run.
# NODE_ENV=development

# Public canonical URL of THIS admin app. Used for OpenGraph metadata in
# src/config/site.config.tsx.
# OPTIONAL — falls back to 'https://isomorphic-furyroad.vercel.app' (a leftover
# template default), so set it or your share previews point at the wrong site.
NEXT_PUBLIC_SITE_URL=http://localhost:4999/

# Brand name shown in the sidebar logo and page titles before the branding API
# response resolves, and if that fetch fails.
# OPTIONAL — code falls back to 'Rawura' in src/config/site.config.tsx and
# packages/isomorphic-core/src/components/logo.tsx.
NEXT_PUBLIC_STORE_NAME=Rawura

# Display name for the app. Declared in src/env.mjs but READ BY NO CODE.
# OPTIONAL — safe to leave unset; kept only so the schema stays documented.
# NEXT_PUBLIC_APP_NAME=Rawura Admin


# ---- Auth & secrets ----

# NextAuth callback/base URL. MUST match the origin you actually browse on,
# including the port, or sign-in redirects break.
# REQUIRED — src/env.mjs validates it as a URL with no fallback; the build
# fails outright if it is missing or not a valid URL.
NEXTAUTH_URL=http://localhost:4999/

# Signing key for the NextAuth JWT session cookie (strategy: 'jwt', 30-day maxAge).
# REQUIRED in production (schema enforces min length 1); optional in development,
# where NextAuth derives an ephemeral key — sessions then drop on every restart.
# Generate a fresh 64-char hex value — do NOT reuse another environment's:
#   openssl rand -hex 32          (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET=CHANGE_ME_run_openssl_rand_hex_32


# ---- Cross-service ----

# Base URL of the Main-server REST API. Every admin request goes through here
# (src/libs/axios.ts baseURL, src/libs/apiRoutes.ts, order product images).
# REQUIRED — src/env.mjs validates it as a URL with no fallback; the build fails
# if unset. (src/utils/storeBranding.ts has its own localhost:3000 fallback, but
# that never rescues you because the schema aborts first.)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public storefront origin. Used for admin->shop deep links: invoice "view order"
# links and the sign-up / forgot-password links in src/config/routes.ts.
# OPTIONAL — src/app/shared/invoice/invoice-preview.tsx falls back to
# 'http://localhost:3009', but src/config/routes.ts does NOT, so leaving this
# unset renders literal "undefined/register" URLs.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3009

# Socket.IO endpoint for live admin product/inventory updates
# (src/hooks/useAdminProductSocket.ts).
# OPTIONAL — falls back to 'http://localhost:3003'.
# REQUIRED-ish — currently MISSING from .env; in any non-local deployment the
# fallback points at localhost and the socket silently never connects, so the
# admin product list stops updating in real time.
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:3003

# Public marketing site origin, used to build shareable intent-shop links in
# src/app/(hydrogen)/marketing/intent-shops/intents-list.tsx.
# OPTIONAL — falls back to 'https://www.rawura.com'.
# Currently MISSING from .env; the fallback is the correct production value, so
# local testing generates links that point at the live site.
NEXT_PUBLIC_MAIN_SITE_URL=https://www.rawura.com

# Shared secret guarding POST /api/revalidate-branding. Main-server sends it so
# this app can purge its cached branding; the route 401s when unset or mismatched
# (src/app/api/revalidate-branding/route.ts).
# REQUIRED — MUST be byte-identical to Main-server's REVALIDATE_SECRET.
# Generate ONCE with `openssl rand -hex 32`, then paste the SAME value into
# Main-server's REVALIDATE_SECRET. A mismatch shows up only as silent 401s on
# /api/revalidate-branding (stale branding), never as a startup error.
REVALIDATE_SECRET=CHANGE_ME_must_match_main_server


# ---- Storage / CDN ----

# Bunny CDN pull-zone base URL used to expand relative media paths into full
# URLs (packages/isomorphic-core/src/utils/cdn-url.ts). A trailing slash is
# added automatically if you omit it.
# OPTIONAL — the same fallback is hardcoded in cdn-url.ts, so leaving this unset
# silently serves media from the legacy test pull zone.
# Get it from: https://dash.bunny.net -> CDN -> your pull zone -> "Hostnames"
# (use the *.b-cdn.net hostname or your own CNAME). Not a secret — it is public
# in the client bundle — but it is environment-specific, so set it per deploy.
# NOTE: the hostname must also be listed in next.config.mjs images.remotePatterns
# or next/image will refuse to render from it.
NEXT_PUBLIC_CDN_BASE_URL=https://<your-pull-zone>.b-cdn.net/

# UploadThing v7 API token — a base64 blob issued per app, read IMPLICITLY by
# `new UTApi()` in src/server/uploadthing.ts and by the route handler in
# src/app/api/uploadthing/route.ts. It is not declared in src/env.mjs, so
# nothing warns you at boot.
# REQUIRED for file upload/delete — currently MISSING from .env; UTApi throws at
# construction time, so src/server/delete-file.ts (deleteFiles) and the
# avatar / generalMedia upload routes fail at runtime.
# Get it from: https://uploadthing.com/dashboard -> your app -> API Keys -> V7 token.
UPLOADTHING_TOKEN=<base64-token-from-uploadthing-dashboard>


# ---- Email (SMTP) ----
# All five are declared OPTIONAL in src/env.mjs and are currently MISSING from
# .env. src/config/mail.ts substitutes placeholder junk ('smtp.google.com',
# port 586, user 'user', pass 'password'), so transactional admin email does not
# merely degrade — it fails to authenticate. Set all five to enable email.

# IMPORTANT — src/config/mail.ts hardcodes `service: 'gmail'` AND `secure: true`.
# `secure: true` means implicit TLS, which is port 465, NOT the STARTTLS port 587.
# Pointing SMTP_PORT at 587 makes nodemailer open a TLS handshake against a
# plaintext port and the send hangs until it times out. Use 465 unless you also
# change `secure` in mail.ts.

# SMTP server hostname.
# OPTIONAL — falls back to the non-functional 'smtp.google.com' (the real Gmail
# host is smtp.gmail.com; the fallback is a typo and will never resolve).
SMTP_HOST=smtp.gmail.com

# SMTP port as a STRING (parsed with parseInt in src/config/mail.ts).
# OPTIONAL — falls back to '586', a typo for 587 that connects to nothing.
# Use 465 — see the `secure: true` note above.
SMTP_PORT=465

# SMTP username / login — for Gmail this is the full address, e.g. bot@rawura.com.
# OPTIONAL — falls back to the literal 'user'.
SMTP_USER=<full-email-address>

# SMTP password. For Gmail/Workspace this MUST be a 16-char App Password, not the
# account password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on that account first).
# For any other provider, take the password from its SMTP credentials page.
# OPTIONAL — falls back to the literal 'password'.
SMTP_PASSWORD=<16-char-app-password>

# Envelope From address. Validated as an email by src/env.mjs when present.
# Used in TWO places with DIFFERENT behaviour:
#   - src/config/mail.ts   -> falls back to 'admin@location.dev'
#   - src/email-templates/email.ts -> NO fallback; renders the From header as
#     "Admin<undefined>", which most SMTP servers reject.
# OPTIONAL by the schema, but effectively REQUIRED if you send any mail.
SMTP_FROM_EMAIL=no-reply@example.com


# ---- Integrations ----

# Google Maps JS API key for the map widgets
# (packages/isomorphic-core/src/components/google-map, listing filters, multi-step form).
# OPTIONAL — src/env.mjs defaults it to an empty string.
# Currently MISSING from .env; the empty key makes every map render blank.
# Get it from: https://console.cloud.google.com/google/maps-apis/credentials
# Restrict it by HTTP referrer — it ships in the client bundle.
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=<google-maps-browser-api-key>

# Google OAuth credentials. Declared in src/env.mjs but READ BY NO CODE:
# src/app/api/auth/[...nextauth]/auth-options.ts registers only
# CredentialsProvider, so there is no Google sign-in to configure.
# OPTIONAL — leave unset unless you add GoogleProvider to auth-options.ts.
# Get them from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>


# ---- Platform-provided (do not set locally) ----

# Injected automatically by Vercel as the deployment hostname (no protocol).
# Used only to build absolute asset URLs in the Dropbox email template
# (src/app/shared/email-templates/dropbox.tsx), which falls back to a relative
# path when unset. Leave it unset in local development.
# VERCEL_URL=
